# ==============================================================================
# DotiBot (.i Domain Autonomous Agent) Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Privy & Web3 Authentication
# ------------------------------------------------------------------------------
VITE_PRIVY_APP_ID=your_privy_app_ID
PRIVY_APP_ID=your_privy_app_ID
PRIVY_APP_SECRET=your_privy_app_secret_here

# ------------------------------------------------------------------------------
# 2. Arbitrum One Blockchain Configuration
# ------------------------------------------------------------------------------
ARBITRUM_RPC_URL=
DOTI_REGISTRY_CONTRACT_ADDRESS=0xf853F8243F10a57CF5e43A49F156F132c05C21a6
DOMAIN_PRICE_ETH=0.001
MAX_DAILY_SPEND_ETH=0.003

# Hard upper bound for value + gas reservations per Twitter transaction.
# The API also sets gas/maxFeePerGas on the submitted transaction.
MAX_TRANSACTION_GAS_ETH=0.0003
# Reject a transaction whose estimated gas (with 20% headroom) exceeds this.
MAX_TRANSACTION_GAS_LIMIT=250000

# ------------------------------------------------------------------------------
# 3. X / Twitter App credentials
# The production route uses OAuth 1.0a User Context:
# API Key + API Secret + Access Token + Access Token Secret.
# "Client ID/Client Secret" are OAuth 2.0 credentials and are not interchangeable.
# See README.md section "Complete X/Twitter Developer setup for this code".
# ------------------------------------------------------------------------------
BOT_USERNAME=dotibot
TWITTER_API_KEY=your_x_api_key
TWITTER_API_SECRET=your_x_api_key_secret
TWITTER_ACCESS_TOKEN=your_bot_account_access_token
TWITTER_ACCESS_SECRET=your_bot_account_access_secret
TWITTER_BEARER_TOKEN=your_twitter_bearer_token

# ------------------------------------------------------------------------------
# 4. Supabase Database (State Machine, Idempotency & Spending Limits)
# ------------------------------------------------------------------------------
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# ------------------------------------------------------------------------------
# 5. Cron Security Token (For cron-job.org or external cron)
# ------------------------------------------------------------------------------
CRON_SECRET=your_custom_secure_cron_token_here

# ------------------------------------------------------------------------------
# 6. API Origin & Optional Twitter Actions
# ------------------------------------------------------------------------------
# Comma-separated exact origins allowed by the local Express server.
ALLOWED_ORIGINS=http://localhost:3000

# Keep both false unless the Twitter action has been separately reviewed.
TWITTER_ENABLE_DOMAIN_REGISTRATION=false
TWITTER_ENABLE_ETH_SEND=false
TWITTER_ENABLE_DOMAIN_TRANSFER=false